{
  "type": "bubble",
  "size": "mega",
  "header": {
    "type": "box",
    "layout": "vertical",
    "background": {
      "type": "linearGradient",
      "angle": "160deg",
      "startColor": "#5BA85F",
      "endColor": "#1C6350"
    },
    "paddingAll": "20px",
    "spacing": "md",
    "contents": [
      {
        "type": "box",
        "layout": "horizontal",
        "spacing": "md",
        "contents": [
          {
            "type": "text",
            "text": "🍚",
            "size": "xxl",
            "flex": 0,
            "gravity": "center"
          },
          {
            "type": "box",
            "layout": "vertical",
            "spacing": "xs",
            "contents": [
              {
                "type": "text",
                "text": "照護回報 · 第 3 / 13 題",
                "size": "xs",
                "color": "#CDECDC"
              },
              {
                "type": "text",
                "text": "進食",
                "size": "xl",
                "weight": "bold",
                "color": "#FDF7E6",
                "wrap": true
              }
            ]
          }
        ]
      },
      {
        "type": "box",
        "layout": "horizontal",
        "height": "12px",
        "backgroundColor": "#17513F",
        "cornerRadius": "6px",
        "contents": [
          {
            "type": "box",
            "layout": "vertical",
            "width": "23%",
            "backgroundColor": "#F7D774",
            "cornerRadius": "6px",
            "contents": [
              {
                "type": "filler"
              }
            ]
          }
        ]
      }
    ]
  },
