{
  "type": "bubble",
  "size": "mega",
  "header": {
    "type": "box",
    "layout": "vertical",
    "background": {
      "type": "linearGradient",
      "angle": "160deg",
      "startColor": "#79B8D1",
      "endColor": "#3E7E99"
    },
    "paddingAll": "20px",
    "spacing": "md",
    "contents": [
      {
        "type": "box",
        "layout": "horizontal",
        "spacing": "md",
        "contents": [
          {
            "type": "text",
            "text": "📸",
            "size": "xxl",
            "flex": 0,
            "gravity": "center"
          },
          {
            "type": "box",
            "layout": "vertical",
            "spacing": "xs",
            "contents": [
              {
                "type": "text",
                "text": "照護回報 · 選填",
                "size": "xs",
                "color": "#CDECDC"
              },
              {
                "type": "text",
                "text": "拍一張今天的牠",
                "size": "xl",
                "weight": "bold",
                "color": "#FDF7E6",
                "wrap": true
              }
            ]
          }
        ]
      }
    ]
  },
  "body": {
    "type": "box",
    "layout": "vertical",
    "backgroundColor": "#FDF7E6",
    "paddingAll": "16px",
    "spacing": "sm",
    "contents": [
      {
        "type": "text",
        "text": "直接在聊天室傳照片就可以了，想傳幾張都行 📷\n沒拍到也沒關係，按略過就好。",
        "color": "#5C7168",
        "size": "sm",
        "wrap": true
      },
      {
        "type": "separator",
        "color": "#DCE9E0",
        "margin": "md"
      },
      {
        "type": "box",
        "layout": "horizontal",
        "spacing": "md",
        "backgroundColor": "#FFFFFF",
        "cornerRadius": "18px",
        "borderWidth": "2px",
        "borderColor": "#DCE9E0",
        "paddingAll": "15px",
        "action": {
          "type": "postback",
          "label": "略過照片",
          "data": "action=skip_media&draft_token=sample-draft-token",
          "displayText": "略過照片"
        },
        "contents": [
          {
            "type": "text",
            "text": "⏭",
            "size": "md",
            "flex": 0
          },
          {
            "type": "text",
            "text": "略過照片",
            "color": "#1F3D36",
            "size": "md",
            "weight": "bold",
            "align": "start",
            "wrap": true,
            "gravity": "center"
          }
        ]
      },
      {
        "type": "box",
        "layout": "horizontal",
        "spacing": "md",
        "backgroundColor": "#FFFFFF",
        "cornerRadius": "18px",
        "borderWidth": "2px",
        "borderColor": "#DCE9E0",
        "paddingAll": "15px",
        "action": {
          "type": "postback",
          "label": "上一步",
          "data": "action=back&draft_token=sample-draft-token",
          "displayText": "上一步"
        },
        "contents": [
          {
            "type": "text",
            "text": "←",
            "size": "md",
            "flex": 0
          },
          {
            "type": "text",
            "text": "上一步",
            "color": "#1F3D36",
            "size": "md",
            "weight": "bold",
            "align": "start",
            "wrap": true,
            "gravity": "center"
          }
        ]
      }
    ]
  },
  "styles": {
    "header": {
      "separator": false
    },
    "body": {
      "separator": false
    }
  }
}