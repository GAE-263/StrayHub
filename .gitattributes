# Cross-platform line endings (Mac + Windows/WSL share this repo).
# Committed, so it wins over each machine's core.autocrlf setting.

# Default: let Git normalize text to LF in the repo, check out native on Windows.
* text=auto

# POSIX-executed files: MUST stay LF everywhere (run via bash/WSL/CI/Docker).
*.sh    text eol=lf
*.bash  text eol=lf
*.py    text eol=lf
*.toml  text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
Dockerfile     text eol=lf
*.dockerfile   text eol=lf
.env*   text eol=lf

# Windows-only scripts: keep CRLF.
*.bat   text eol=crlf
*.cmd   text eol=crlf
*.ps1   text eol=crlf

# Binaries: never touch.
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.pdf   binary
*.woff  binary
*.woff2 binary
