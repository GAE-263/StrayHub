{
  "type": "bubble",
  "size": "mega",
  "header": {
    "type": "box",
    "layout": "vertical",
    "backgroundColor": "#A8C69F",
    "paddingAll": "18px",
    "spacing": "md",
    "contents": [
      {
        "type": "box",
        "layout": "horizontal",
        "spacing": "md",
        "contents": [
          {
            "type": "text",
            "text": "🎉",
            "size": "xxl",
            "flex": 0,
            "gravity": "center"
          },
          {
            "type": "box",
            "layout": "vertical",
            "spacing": "xs",
            "contents": [
              {
                "type": "text",
                "text": "辛苦了，謝謝你",
                "size": "xs",
                "color": "#716053",
                "wrap": true
              },
              {
                "type": "text",
                "text": "回報完成",
                "size": "xl",
                "weight": "bold",
                "color": "#716053",
                "wrap": true
              }
            ]
          }
        ]
      }
    ]
  },
  "body": {
    "type": "box",
    "layout": "vertical",
    "backgroundColor": "#FFFCF3",
    "paddingAll": "16px",
    "spacing": "md",
    "contents": [
      {
        "type": "text",
        "text": "陪 小黑 的紀錄已經收好了 🌟",
        "color": "#716053",
        "size": "md",
        "weight": "bold",
        "wrap": true,
        "align": "center"
      },
      {
        "type": "text",
        "text": "AI 分析會在背景進行，不影響這筆紀錄。",
        "color": "#9C8B7D",
        "size": "xs",
        "wrap": true,
        "align": "center"
      },
      {
        "type": "text",
        "text": "下次要回報，再按一次選單就好 🐾",
        "size": "xxs",
        "color": "#9C8B7D",
        "align": "center"
      }
    ]
  },
  "styles": {
    "header": {
      "separator": true,
      "separatorColor": "#716053"
    }
  }
}