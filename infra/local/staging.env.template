# Copy OUTSIDE the repository, chmod 600, replace all REPLACE values.
# No production secrets/data. JWT paths must be absolute.
APP_ENV=local
POSTGRES_DB=strayhub_staging
POSTGRES_USER=staging_migration
POSTGRES_PASSWORD=REPLACE_MIGRATION_PASSWORD
POSTGRES_RUNTIME_USER=staging_app
POSTGRES_RUNTIME_PASSWORD=REPLACE_RUNTIME_PASSWORD
DATABASE_URL=postgresql+asyncpg://staging_app:REPLACE_RUNTIME_PASSWORD@postgres:5432/strayhub_staging
DATABASE_MIGRATION_URL=postgresql+asyncpg://staging_migration:REPLACE_MIGRATION_PASSWORD@postgres:5432/strayhub_staging
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=staging-storage
MINIO_SECRET_KEY=REPLACE_STORAGE_PASSWORD
MINIO_BUCKET=strayhub-staging
REDIS_PASSWORD=REPLACE_REDIS_PASSWORD
REDIS_MAXMEMORY=256mb
CELERY_BROKER_URL=redis://:REPLACE_REDIS_PASSWORD@redis:6379/0
CELERY_AI_ENABLED=false
CELERY_WORKER_CONCURRENCY=1
AI_PROVIDER=mock
LINE_CHANNEL_ID=local-staging-disabled
LINE_CHANNEL_SECRET=local-staging-disabled
LINE_CHANNEL_ACCESS_TOKEN=local-staging-disabled
LIFF_ID=local-staging-disabled
LINE_LOGIN_CHANNEL_ID=local-staging-disabled
ANIMAL_CONFIRMATION_SECRET=REPLACE_CONFIRMATION_SECRET
LOGIN_ABUSE_HMAC_SECRET=REPLACE_LOGIN_SECRET
AUTH_JWT_ISSUER=strayhub-local-staging
AUTH_JWT_AUDIENCE=strayhub-api
AUTH_JWT_ACTIVE_PRIVATE_KEY_REFERENCE=staging-private
AUTH_JWT_ACTIVE_PUBLIC_KEY_REFERENCE=staging-public
AUTH_JWT_ACTIVE_PRIVATE_KEY_FILE=/REPLACE/staging-jwt-private.pem
AUTH_JWT_ACTIVE_PUBLIC_KEY_FILE=/REPLACE/staging-jwt-public.pem
PII_ENCRYPTION_PROVIDER=local-aes-gcm
PII_KMS_KEY_NAME=unused-local-staging
PII_LOCAL_KEY_BASE64=REPLACE_BASE64_32_BYTE_KEY
E4_API_UPSTREAM_HOST_PORT=18082
E4_WEB_UPSTREAM_HOST_PORT=13002
