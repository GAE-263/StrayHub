pid nginx.pid;
error_log logs/error.log notice;

events {}

http {
    map $uri $strayhub_capability_access {
        default 0;
        ~^/v1/public/(adoption/)?animals/[^/]+/photo/?$ 1;
    }

    map $strayhub_capability_access $strayhub_standard_access {
        0 1;
        1 0;
    }

    log_format strayhub_standard
        '$remote_addr - $remote_user [$time_local] "$request" $status $body_bytes_sent '
        '"$http_referer" "$http_user_agent"';
    log_format strayhub_capability
        '$remote_addr - $remote_user [$time_local] '
        '"$request_method $uri $server_protocol" $status $body_bytes_sent rt=$request_time';

    access_log logs/access.log strayhub_standard if=$strayhub_standard_access;
    access_log logs/access.log strayhub_capability if=$strayhub_capability_access;

    map $http_upgrade $connection_upgrade {
        default upgrade;
        "" close;
    }

    map $http_x_forwarded_proto $forwarded_proto {
        default $http_x_forwarded_proto;
        "" $scheme;
    }

    upstream strayhub_api {
        server 127.0.0.1:__API_PORT__;
    }

    upstream strayhub_web {
        server 127.0.0.1:__WEB_PORT__;
    }

    server {
        listen 127.0.0.1:__NGINX_PORT__;
        server_name localhost;

        location = /healthz {
            proxy_pass http://strayhub_api;
            proxy_set_header Host $http_host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $forwarded_proto;
        }

        # No URI suffix on proxy_pass: FastAPI receives the complete /v1/... path.
        location ^~ /v1/ {
            proxy_pass http://strayhub_api;
            proxy_set_header Host $http_host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $forwarded_proto;
        }

        location = /volunteer-application {
            proxy_pass http://strayhub_web;
            proxy_http_version 1.1;
            proxy_set_header Host $http_host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $forwarded_proto;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $connection_upgrade;
        }

        # Next.js assets and webpack HMR must never fall through to FastAPI.
        location ^~ /_next/ {
            proxy_pass http://strayhub_web;
            proxy_http_version 1.1;
            proxy_set_header Host $http_host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $forwarded_proto;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $connection_upgrade;
        }

        location / {
            proxy_pass http://strayhub_web;
            proxy_http_version 1.1;
            proxy_set_header Host $http_host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $forwarded_proto;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $connection_upgrade;
        }
    }
}
