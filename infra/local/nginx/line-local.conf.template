pid nginx.pid;
error_log logs/error.log notice;

events {}

http {
    map $uri $strayhub_sensitive_access {
        default 0;
        ~^/(login|volunteer-entry|volunteer-application|animal-confirmation)/?$ 1;
        ~^/v1/auth/(login|refresh|liff/exchange)/?$ 1;
        ~^/v1/public/(adoption/)?animals/[^/]+/photo/?$ 1;
    }

    map $strayhub_sensitive_access $strayhub_standard_access {
        0 1;
        1 0;
    }

    log_format strayhub_standard
        '$remote_addr - $remote_user [$time_local] "$request" $status $body_bytes_sent '
        '"$http_referer" "$http_user_agent"';
    log_format strayhub_sensitive
        '$remote_addr - $remote_user [$time_local] '
        '"$request_method $uri $server_protocol" $status $body_bytes_sent rt=$request_time';

    access_log logs/access.log strayhub_standard if=$strayhub_standard_access;
    access_log logs/access.log strayhub_sensitive if=$strayhub_sensitive_access;

    map $http_upgrade $connection_upgrade {
        default upgrade;
        "" close;
    }

    map $http_x_forwarded_proto $forwarded_proto {
        default $http_x_forwarded_proto;
        "" $scheme;
    }

    upstream strayhub_api {
        server 127.0.0.1:__API_PORT__;
    }

    upstream strayhub_web {
        server 127.0.0.1:__WEB_PORT__;
    }

    server {
        listen 127.0.0.1:__NGINX_PORT__;
        server_name localhost;

        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;

        # allowlist: volunteer_entry_page
        location = /volunteer-entry {
            if ($request_method !~ ^(GET|HEAD)$) { return 404; }
            proxy_pass http://strayhub_web;
        }

        # allowlist: volunteer_application_page
        location = /volunteer-application {
            if ($request_method !~ ^(GET|HEAD)$) { return 404; }
            proxy_pass http://strayhub_web;
        }

        # allowlist: animal_confirmation_page
        location = /animal-confirmation {
            if ($request_method !~ ^(GET|HEAD)$) { return 404; }
            proxy_pass http://strayhub_web;
        }

        # allowlist: care_report_fallback_page
        location = /care-report {
            if ($request_method !~ ^(GET|HEAD)$) { return 404; }
            proxy_pass http://strayhub_web;
        }

        # allowlist: next_static_assets
        location ~ "^/_next/static/[A-Za-z0-9_./-]+$" {
            if ($request_method !~ ^(GET|HEAD)$) { return 404; }
            proxy_pass http://strayhub_web;
        }

        # allowlist: next_dev_hmr
        location = /_next/webpack-hmr {
            if ($request_method != GET) { return 404; }
            proxy_pass http://strayhub_web;
        }

        # allowlist: line_webhook
        location = /v1/line/webhook {
            if ($request_method != POST) { return 404; }
            proxy_pass http://strayhub_api;
        }

        # allowlist: liff_exchange
        # allowlist: session_refresh
        # allowlist: volunteer_application_status
        # allowlist: volunteer_application_self_status
        # allowlist: volunteer_application_submit
        # allowlist: qr_resolve
        # allowlist: qr_candidate_organization
        # allowlist: care_report_handoff
        location ~ ^/v1/(auth/(liff/exchange|refresh)|volunteer-applications(/(status|self-status))?|qr-tokens/(resolve|candidate-organization)|care-report-handoffs)$ {
            if ($request_method != POST) { return 404; }
            proxy_pass http://strayhub_api;
        }

        # allowlist: current_identity
        # allowlist: public_volunteer_organizations
        # allowlist: animal_search
        # allowlist: current_line_draft
        location ~ ^/v1/(auth/me|public/volunteer-organizations|animals/search|line/care-report/drafts/current)$ {
            if ($request_method != GET) { return 404; }
            proxy_pass http://strayhub_api;
        }

        # allowlist: active_shelter_context
        location = /v1/auth/active-shelter-context {
            if ($request_method !~ ^(GET|PUT)$) { return 404; }
            proxy_pass http://strayhub_api;
        }

        # allowlist: volunteer_application_withdraw
        location ~ "^/v1/volunteer-applications/[0-9a-fA-F-]{36}/withdraw$" {
            if ($request_method != POST) { return 404; }
            proxy_pass http://strayhub_api;
        }

        # allowlist: animal_confirm
        location ~ "^/v1/animals/[0-9a-fA-F-]{36}/confirm$" {
            if ($request_method != POST) { return 404; }
            proxy_pass http://strayhub_api;
        }

        # allowlist: update_care_report_draft
        location ~ "^/v1/care-report-drafts/[0-9a-fA-F-]{36}$" {
            if ($request_method != PATCH) { return 404; }
            proxy_pass http://strayhub_api;
        }

        # allowlist: volunteer_walk_photo
        location ~ "^/v1/public/animals/[0-9a-fA-F-]{36}/photo$" {
            if ($request_method !~ ^(GET|HEAD)$) { return 404; }
            proxy_pass http://strayhub_api;
        }

        # allowlist: public_adoption_photo
        location ~ "^/v1/public/adoption/animals/[0-9a-fA-F-]{36}/photo$" {
            if ($request_method !~ ^(GET|HEAD)$) { return 404; }
            proxy_pass http://strayhub_api;
        }

        location / {
            default_type text/plain;
            return 404;
        }
    }
}
