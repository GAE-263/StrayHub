# NON-SECRET ACCEPTANCE TEMPLATE ONLY
# Copy outside the repository, chmod 0600, and combine with the dedicated
# /var/lib/strayhub/acceptance/secrets/current/runtime.env generation.

APP_ENV=acceptance
ACCEPTANCE_BIND_HOST=127.0.0.1
ACCEPTANCE_WEB_HOST_PORT=13000
ACCEPTANCE_API_HOST_PORT=18080
ACCEPTANCE_INGRESS_MODE=external-https-to-loopback-web
ACCEPTANCE_INGRESS_UPSTREAM=http://127.0.0.1:13000

POSTGRES_DB=strayhub_acceptance
POSTGRES_USER=strayhub_acceptance_migration
POSTGRES_RUNTIME_USER=strayhub_acceptance_app

MINIO_ENDPOINT=http://minio:9000
MINIO_BUCKET=strayhub-acceptance-private
REDIS_MAXMEMORY=128mb

CELERY_AI_ENABLED=false
CELERY_QUEUE_AI=acceptance-ai
CELERY_QUEUE_SYSTEM=acceptance-system
CELERY_TASK_SOFT_TIME_LIMIT=30
CELERY_TASK_TIME_LIMIT=45
CELERY_VISIBILITY_TIMEOUT=120
CELERY_MAX_RETRIES=2
CELERY_RETRY_BACKOFF_MAX=60
CELERY_RECONCILE_INTERVAL_SECONDS=30
CELERY_WORKER_CONCURRENCY=1

# Dedicated acceptance LINE Messaging API channel and LIFF app only.
LINE_CHANNEL_ID=
# Comparison-only, non-secret production channel ID. Preflight rejects equality.
PRODUCTION_LINE_CHANNEL_ID_FOR_ISOLATION_CHECK=
LINE_LOGIN_CHANNEL_ID=
LIFF_ID=
WEB_PUBLIC_BASE_URL=
# Comma-separated lowercase SHA-256 digests of at least two controlled test
# LINE user IDs. All other acceptance push attempts fail closed.
LINE_NOTIFICATION_RECIPIENT_ALLOWLIST_SHA256=
# Gate 3 requires this to be true only after the existing acceptance menus and
# commit-bound smoke evidence below have been verified.
LINE_ROLE_MENU_FEATURES_ENABLED=false
LINE_STAFF_MENU_ENABLED=false
LINE_RICH_MENU_DEFAULT_ID=
LINE_RICH_MENU_VOLUNTEER_ID=
LINE_RICH_MENU_STAFF_ID=
LINE_RICH_MENU_ADOPTER_ID=
LINE_RICH_MENU_ADOPTION_HUB_ID=
LINE_STAFF_LIFF_ID=
LINE_ROLE_MENU_SMOKE_EVIDENCE=
# Acceptance uses dedicated, protected identities and production-like evidence.
LINE_ROLE_MENU_TEST_ENABLED=false
LINE_ROLE_MENU_TEST_CHANNEL_ID=
LINE_ROLE_MENU_BOT_SHA256=
LINE_ROLE_MENU_TEST_USER_SHA256=
LINE_ROLE_MENU_TEST_EXPIRES_AT=
LINE_ROLE_MENU_REPORT_PATH=/dev/null
LINE_ROLE_MENU_REPORT_SHA256=
LINE_ROLE_MENU_RESOURCES_PATH=/dev/null
LINE_ROLE_MENU_RELEASE_MANIFEST=/dev/null

AUTH_JWT_ISSUER=strayhub-acceptance
AUTH_JWT_AUDIENCE=strayhub-api
AUTH_JWT_ACTIVE_PRIVATE_KEY_REFERENCE=acceptance-active-key
AUTH_JWT_ACTIVE_PUBLIC_KEY_REFERENCE=acceptance-active-public-key
AUTH_JWT_ACTIVE_PRIVATE_KEY_FILE=/var/lib/strayhub/acceptance/secrets/current/jwt-private.pem
AUTH_JWT_ACTIVE_PUBLIC_KEY_FILE=/var/lib/strayhub/acceptance/secrets/current/jwt-public.pem

PII_ENCRYPTION_PROVIDER=gcp-kms
PII_ALLOW_LOCAL_PROVIDER=false
PII_KMS_KEY_NAME=

AI_PROVIDER=mock
AI_ENDPOINT=
AI_MODEL_NAME=acceptance-mock
GEMINI_MODEL_NAME=gemini-3.5-flash-lite
GEMINI_SERVICE_ACCOUNT_PATH=
GEMINI_VERTEX_LOCATION=global
STOOL_API_URL=
STOOL_TIMEOUT_SECONDS=30

# Consumed by the base Compose during interpolation; the override replaces its
# host-port definitions with the acceptance variables above.
E4_CANONICAL_HOSTNAME=
E4_WEB_UPSTREAM_HOST_PORT=13000
E4_API_UPSTREAM_HOST_PORT=18080
