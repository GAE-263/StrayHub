# NON-SECRET PRODUCTION TEMPLATE ONLY
# Copy to a protected host location and fill every empty non-secret value. Combine it with
# /var/lib/strayhub/secrets/current/runtime.env; never put secret values in this file or Git.

APP_ENV=production
B1_VERIFICATION_ONLY=false

POSTGRES_DB=strayhub
POSTGRES_USER=strayhub_migration
POSTGRES_RUNTIME_USER=strayhub_app

MINIO_ENDPOINT=http://minio:9000
MINIO_BUCKET=strayhub-private

LINE_CHANNEL_ID=
LIFF_ID=

AUTH_JWT_ISSUER=
AUTH_JWT_AUDIENCE=strayhub-api
AUTH_JWT_ACTIVE_PRIVATE_KEY_REFERENCE=
AUTH_JWT_ACTIVE_PUBLIC_KEY_REFERENCE=
AUTH_JWT_ACTIVE_PRIVATE_KEY_FILE=/var/lib/strayhub/secrets/current/jwt-private.pem
AUTH_JWT_ACTIVE_PUBLIC_KEY_FILE=/var/lib/strayhub/secrets/current/jwt-public.pem

PII_ENCRYPTION_PROVIDER=gcp-kms
PII_KMS_KEY_NAME=

AI_PROVIDER=mock
AI_ENDPOINT=
AI_MODEL_NAME=

B4_HTTP_HOST_PORT=80
B4_HTTPS_HOST_PORT=443
B4_LETSENCRYPT_DIR=/etc/letsencrypt
B4_ACME_WEBROOT=/var/lib/strayhub/acme-webroot
