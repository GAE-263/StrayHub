# NON-SECRET PRODUCTION TEMPLATE ONLY
# Copy to a protected host location and fill every empty non-secret value. Combine it with
# /var/lib/strayhub/secrets/current/runtime.env; never put secret values in this file or Git.

APP_ENV=production
B1_VERIFICATION_ONLY=false

POSTGRES_DB=strayhub
POSTGRES_USER=strayhub_migration
POSTGRES_RUNTIME_USER=strayhub_app

MINIO_ENDPOINT=http://minio:9000
MINIO_BUCKET=strayhub-private

# REDIS_PASSWORD and the credential-bearing CELERY_BROKER_URL belong in the
# protected runtime.env, not this non-secret template.
REDIS_MAXMEMORY=256mb
CELERY_AI_ENABLED=false
CELERY_QUEUE_AI=ai
CELERY_QUEUE_SYSTEM=system
CELERY_TASK_SOFT_TIME_LIMIT=45
CELERY_TASK_TIME_LIMIT=60
CELERY_VISIBILITY_TIMEOUT=180
CELERY_MAX_RETRIES=3
CELERY_RETRY_BACKOFF_MAX=120
CELERY_RECONCILE_INTERVAL_SECONDS=30
CELERY_WORKER_CONCURRENCY=2
GEMINI_MODEL_NAME=gemini-3.5-flash-lite
GEMINI_SERVICE_ACCOUNT_PATH=
GEMINI_VERTEX_LOCATION=global

LINE_CHANNEL_ID=
LIFF_ID=

# Keep false until the conditional production-preflight requirements and real LINE smoke pass.
LINE_ROLE_MENU_FEATURES_ENABLED=false
LINE_STAFF_MENU_ENABLED=false
WEB_PUBLIC_BASE_URL=
LINE_RICH_MENU_DEFAULT_ID=
LINE_RICH_MENU_ADOPTION_HUB_ID=
LINE_RICH_MENU_VOLUNTEER_ID=
LINE_RICH_MENU_STAFF_ID=
LINE_STAFF_LIFF_ID=
LINE_ROLE_MENU_SMOKE_EVIDENCE=
# Protected scoped-test identity and timebox. Keep disabled and empty by default.
LINE_ROLE_MENU_TEST_ENABLED=false
LINE_ROLE_MENU_TEST_CHANNEL_ID=
LINE_ROLE_MENU_BOT_SHA256=
LINE_ROLE_MENU_TEST_USER_SHA256=
LINE_ROLE_MENU_TEST_EXPIRES_AT=
# Protected operator evidence inputs. Do not replace these with committed fixtures.
LINE_ROLE_MENU_REPORT_PATH=/dev/null
LINE_ROLE_MENU_REPORT_SHA256=
LINE_ROLE_MENU_RESOURCES_PATH=/dev/null
LINE_ROLE_MENU_RELEASE_MANIFEST=/dev/null

AUTH_JWT_ISSUER=
AUTH_JWT_AUDIENCE=strayhub-api
AUTH_JWT_ACTIVE_PRIVATE_KEY_REFERENCE=
AUTH_JWT_ACTIVE_PUBLIC_KEY_REFERENCE=
AUTH_JWT_ACTIVE_PRIVATE_KEY_FILE=/var/lib/strayhub/secrets/current/jwt-private.pem
AUTH_JWT_ACTIVE_PUBLIC_KEY_FILE=/var/lib/strayhub/secrets/current/jwt-public.pem

PII_ENCRYPTION_PROVIDER=gcp-kms
PII_KMS_KEY_NAME=

AI_PROVIDER=mock
AI_ENDPOINT=
AI_MODEL_NAME=
STOOL_API_URL=
STOOL_TIMEOUT_SECONDS=30

# Host-side backup transport only; these are not injected into application containers.
GCS_BACKUP_BUCKET=
GCS_BACKUP_PREFIX=strayhub-backups
BACKUP_ENVIRONMENT=production

E4_CANONICAL_HOSTNAME=strayhub.enadv.quest
E4_WEB_UPSTREAM_HOST_PORT=3000
E4_API_UPSTREAM_HOST_PORT=8080
