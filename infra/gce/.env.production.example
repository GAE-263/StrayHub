# SYNTHETIC VERIFICATION ONLY
# NOT FOR REAL DEPLOYMENT
# Phase B2 uses APP_ENV=gcp-demo so the existing non-local fail-fast policy is active.
# Preflight generates the ignored JWT files below. Never use them for production, staging, shared
# demos, external traffic, or Secret Manager uploads.

APP_ENV=gcp-demo
B1_VERIFICATION_ONLY=true

POSTGRES_DB=strayhub_b1_verify
POSTGRES_USER=strayhub_migration
POSTGRES_PASSWORD=B1VerifyMigration-7Qm9Vt4Kp2Hs
POSTGRES_RUNTIME_USER=strayhub_app
POSTGRES_RUNTIME_PASSWORD=B1VerifyRuntime-8Rx4Kn6Vp9Ts
DATABASE_URL=postgresql+asyncpg://strayhub_app:B1VerifyRuntime-8Rx4Kn6Vp9Ts@postgres:5432/strayhub_b1_verify
DATABASE_MIGRATION_URL=postgresql+asyncpg://strayhub_migration:B1VerifyMigration-7Qm9Vt4Kp2Hs@postgres:5432/strayhub_b1_verify

MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=b1verifyaccess2026
MINIO_SECRET_KEY=B1VerifyStorage-8Rm4Wq7Ts2Kp9Nv6
MINIO_BUCKET=strayhub-private

LINE_CHANNEL_ID=9876543210
LINE_CHANNEL_SECRET=8f3c7a2e9d4b6f1a5c8e0b7d3a9f2c6e
LINE_CHANNEL_ACCESS_TOKEN=b1verify-line-token-7Qm9Vt4Kp2Hs6Nx8
LIFF_ID=9876543210-AbCdEfGh

ANIMAL_CONFIRMATION_SECRET=b1verify-confirmation-6Tp9Qm3Vs8Kn4Rx7
AUTH_JWT_ISSUER=strayhub-b1-verification
AUTH_JWT_AUDIENCE=strayhub-api
AUTH_JWT_ACTIVE_PRIVATE_KEY_REFERENCE=b1-verification-private-20260829
AUTH_JWT_ACTIVE_PUBLIC_KEY_REFERENCE=b1-verification-public-20260829
AUTH_JWT_ACTIVE_PRIVATE_KEY_FILE=./verification/generated/jwt-private.pem
AUTH_JWT_ACTIVE_PUBLIC_KEY_FILE=./verification/generated/jwt-public.pem

PII_ENCRYPTION_PROVIDER=gcp-kms
PII_KMS_KEY_NAME=projects/strayhub-b1-verify/locations/asia-east1/keyRings/b1-runtime/cryptoKeys/pii-verification

AI_PROVIDER=mock

# Single-edge verification ports. GCP firewall policy admits these production host ports only from
# the canonical edge VM; the synthetic Compose environment is never an authorization boundary.
E4_CANONICAL_HOSTNAME=strayhub.enadv.quest
E4_WEB_UPSTREAM_HOST_PORT=3000
E4_API_UPSTREAM_HOST_PORT=8080
