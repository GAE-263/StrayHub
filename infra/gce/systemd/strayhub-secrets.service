[Unit]
Description=StrayHub production secret staging
Wants=network-online.target
After=network-online.target
Before=strayhub-migrate.service strayhub.service
ConditionPathExists=/etc/strayhub/production.env

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
WorkingDirectory=/opt/strayhub/current
ExecStart=/opt/strayhub/current/infra/gce/scripts/fetch-secrets.sh --project canvas-primacy-502703-k1 --environment prod --output-root /var/lib/strayhub/secrets
ExecStartPost=/bin/chown -R strayhub:strayhub /var/lib/strayhub/secrets
RemainAfterExit=yes
PrivateTmp=true
