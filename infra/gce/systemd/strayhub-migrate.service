[Unit]
Description=StrayHub production preflight and database migration
Requires=docker.service strayhub-secrets.service
After=network-online.target docker.service strayhub-secrets.service
Before=strayhub.service

[Service]
Type=oneshot
User=strayhub
Group=strayhub
SupplementaryGroups=docker
WorkingDirectory=/opt/strayhub/current
ExecStartPre=/opt/strayhub/current/infra/gce/scripts/production-preflight.sh --config-env /etc/strayhub/production.env --secrets-root /var/lib/strayhub/secrets --project-name strayhub-d1-preflight-systemd --image-env /opt/strayhub/current/image-digests.env
ExecStart=/usr/bin/docker compose --project-name strayhub-production --file /opt/strayhub/current/infra/gce/docker-compose.production.yml --env-file /etc/strayhub/production.env --env-file /var/lib/strayhub/secrets/current/runtime.env --env-file /opt/strayhub/current/image-digests.env --profile tools run --rm migration
RemainAfterExit=yes
TimeoutStartSec=600
NoNewPrivileges=true
PrivateTmp=true
